{
  "name": "nasza-lista-zakupow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./styles.input.css -o ./public/styles.css --minify",
    "test:unit": "node --test tests/utils.test.mjs tests/static.test.mjs",
    "test:rules": "npx --yes firebase-tools@15.22.4 emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test": "npm run test:unit && npm run test:rules",
    "serve": "firebase emulators:start --only hosting,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@tailwindcss/cli": "4.3.3",
    "firebase": "12.16.0",
    "tailwindcss": "4.3.3"
  }
}
