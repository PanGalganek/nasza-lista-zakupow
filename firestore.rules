rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn() && allowedRole(request.auth.uid);
    }

    function allowedRole(uid) {
      let user = get(/databases/$(database)/documents/app_users/$(uid)).data;
      return user.active == true && user.role in ['admin', 'operator'];
    }

    function validDate(value) {
      return value is string
        && (value == '' || value.matches('^\\d{4}-((0[13578]|1[02])-(0[1-9]|[12]\\d|3[01])|(0[469]|11)-(0[1-9]|[12]\\d|30)|02-(0[1-9]|1\\d|2[0-9]))$'));
    }

    function validChemical(data) {
      return data.keys().hasAll(['name', 'group', 'usage', 'received', 'expiry', 'timestamp', 'ordered'])
        && data.keys().hasOnly(['name', 'group', 'usage', 'received', 'expiry', 'timestamp', 'ordered', 'category',
          'productId', 'lotNumber', 'producer', 'formula', 'cas', 'packageAmount', 'packageUnit', 'orderPackages', 'orderDescription', 'orderPackaging'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.group is string && data.group.size() <= 100
        && data.usage is string && data.usage.size() <= 500
        && validDate(data.received)
        && validDate(data.expiry)
        && data.timestamp is int
        && data.ordered is bool
        && (!('category' in data) || data.category in ['Wzorce', 'Odczynniki', 'Standardowe'])
        && (!('productId' in data) || (data.productId is string && data.productId.matches('^[A-Za-z0-9_-]{1,128}$')))
        && optionalText(data, 'lotNumber', 100)
        && optionalText(data, 'producer', 200)
        && optionalText(data, 'formula', 100)
        && optionalText(data, 'cas', 40)
        && optionalText(data, 'orderDescription', 4000)
        && validOrderPackaging(data.get('orderPackaging', null))
        && (!('packageAmount' in data) || (amount(data.packageAmount) && data.packageAmount > 0 && unit(data.packageUnit)))
        && (!('packageUnit' in data) || 'packageAmount' in data)
        && (!('orderPackages' in data) || (data.orderPackages is int && data.orderPackages >= 1 && data.orderPackages <= 10000));
    }

    function validOrderPackaging(value) {
      return value == null || (value is map && value.keys().hasOnly(['amount', 'unit'])
        && amount(value.amount) && value.amount > 0 && unit(value.unit));
    }

    function optionalText(data, key, limit) {
      return !(key in data) || (data[key] is string && data[key].size() <= limit);
    }

    function unit(value) {
      return value in ['mg', 'g', 'kg', 'µl', 'ml', 'l', 'szt.', 'testów'];
    }

    function sameDimension(first, second) {
      return first == second
        || (first in ['mg', 'g', 'kg'] && second in ['mg', 'g', 'kg'])
        || (first in ['µl', 'ml', 'l'] && second in ['µl', 'ml', 'l']);
    }

    function amount(value) {
      return value is int && value >= 0 && value <= 1000000000000;
    }

    function stockPath(id) {
      return /databases/$(database)/documents/magazyn_partie/$(id);
    }

    function eventPath(id) {
      return /databases/$(database)/documents/magazyn_operacje/$(id);
    }

    function chemicalPath(id) {
      return /databases/$(database)/documents/odczynniki/$(id);
    }

    function orderPath(id) {
      return /databases/$(database)/documents/magazyn_zamowienia/$(id);
    }

    function validDeliveryLink(link) {
      return link is map && link.keys().hasOnly(['orderId', 'lineIndex', 'complete'])
        && link.orderId is string && link.orderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && link.lineIndex is int && link.lineIndex >= 0 && link.complete is bool;
    }

    function linkedOrderReceipt(link, eventId) {
      return validDeliveryLink(link)
        && get(orderPath(link.orderId)).data.get('lastReceipt', '') != eventId
        && getAfter(orderPath(link.orderId)).data.lastReceipt == eventId;
    }

    function orderedPackages(line) {
      return 'packages' in line ? line.packages
        : (line.amount == '' ? 0 : (line.amount.matches('^\\d+ × .*$') ? int(line.amount.split(' × ')[0]) : 1));
    }

    function validDeliveryProgress(previous, current, key, count, complete) {
      let before = previous.get(key, {'received': 0, 'complete': false});
      let after = current[key];
      return current.diff(previous).affectedKeys().hasOnly([key]) && !before.complete
        && after is map && after.keys().hasOnly(['received', 'complete'])
        && after.received is int && after.received == before.received + 1 && after.received <= 10000
        && after.complete == complete
        && (count == 0 || (count is int && count > 0 && after.received <= count && complete == (after.received == count)));
    }

    function sameLegacyProduct(sourceId, targetId) {
      let source = get(chemicalPath(sourceId)).data;
      let target = get(chemicalPath(targetId)).data;
      let chem = source.get('category', 'Wzorce') == 'Odczynniki';
      return !('productId' in source) && source.group.split('/')[0] != ''
        && source.group.split('/')[0] == target.group.split('/')[0] && source.name == target.name
        && chem == (target.get('category', 'Wzorce') == 'Odczynniki') && (chem || source.usage == target.usage)
        && compatibleCatalogValue(source, target, 'producer') && compatibleCatalogValue(source, target, 'cas')
        && compatibleCatalogValue(source, target, 'formula') && compatibleCatalogValue(source, target, 'orderDescription');
    }

    function compatibleCatalogValue(source, target, key) {
      return source.get(key, '') == '' || target.get(key, '') == '' || source[key] == target[key];
    }

    function matchesDeliveryProduct(event, line) {
      let targetId = event.changes[event.anchor].productId;
      return targetId == line.productId || sameLegacyProduct(line.productId, targetId);
    }

    function updatesReceivedOrder(id, before, after) {
      let eventId = after.lastReceipt;
      let event = getAfter(eventPath(eventId)).data;
      let link = event.details.delivery;
      let index = link.lineIndex;
      return before.status == 'ordered'
        && after.diff(before).affectedKeys().hasOnly(['deliveries', 'lastReceipt'])
        && eventId is string && eventId.matches('^[A-Za-z0-9_-]{1,150}$') && !exists(eventPath(eventId))
        && event.kind == 'receipt' && event.changes.size() == 1 && validDeliveryLink(link)
        && link.orderId == id && index < before.lines.size()
        && matchesDeliveryProduct(event, before.lines[index])
        && validDeliveryProgress(before.get('deliveries', {}), after.deliveries, string(index),
          orderedPackages(before.lines[index]), link.complete);
    }

    function isProductRoot(id, newLot) {
      let target = getAfter(chemicalPath(id)).data;
      return target.productId == id
        && (target.get('category', 'Wzorce') == 'Odczynniki') == (newLot.get('category', 'Wzorce') == 'Odczynniki');
    }

    function validStock(data) {
      return data.keys().hasAll(['initial', 'balance', 'unit', 'status', 'lastEvent'])
        && data.keys().hasOnly(['initial', 'balance', 'unit', 'status', 'lastEvent'])
        && data.status in ['active', 'used', 'withdrawn']
        && data.lastEvent is string && data.lastEvent.matches('^[A-Za-z0-9_-]{1,150}$')
        && ((amount(data.initial) && amount(data.balance) && data.balance <= data.initial && unit(data.unit))
          || (data.status != 'active' && data.initial == null && data.balance == null && data.unit == ''));
    }

    function linkedStock(id, state) {
      let event = getAfter(eventPath(state.lastEvent)).data;
      let row = event.changes[id];
      let lot = getAfter(chemicalPath(id)).data;
      return !exists(eventPath(state.lastEvent))
        && row.productId == lot.get('productId', id) && row.number == lot.get('lotNumber', '')
        && row.name == lot.name && row.unit == state.unit && row.initial == state.initial
        && row.after == state.balance && row.status == state.status;
    }

    function startingStock(id, state) {
      let event = getAfter(eventPath(state.lastEvent)).data;
      let row = event.changes[id];
      let lot = getAfter(chemicalPath(id)).data;
      return (event.kind == 'receipt' && !exists(chemicalPath(id)) && row.before == 0
          && state.status == 'active' && state.initial > 0 && state.balance == state.initial
          && state.unit == lot.packageUnit && state.initial <= lot.packageAmount
          && lot.lotNumber is string && lot.lotNumber.size() > 0)
        || (event.kind == 'opening' && exists(chemicalPath(id)) && row.before == state.initial
          && state.status == 'active' && state.balance == state.initial
          && sameDimension(state.unit, lot.get('packageUnit', state.unit)))
        || (event.kind in ['used', 'withdrawn'] && exists(chemicalPath(id)) && state.status == event.kind
          && row.before == null && state.initial == null);
    }

    function reversalAmount(event, id) {
      let prior = get(eventPath(event.details.originalId)).data.changes[id];
      return prior.before - prior.after;
    }

    function changingStock(id, previous, state) {
      let event = getAfter(eventPath(state.lastEvent)).data;
      let row = event.changes[id];
      return previous.status == 'active' && state.initial == previous.initial && state.unit == previous.unit
        && row.before == previous.balance && state.lastEvent != previous.lastEvent
        && ((event.kind in ['withdrawal', 'preparation'] && state.status == 'active' && state.balance < previous.balance)
          || (event.kind in ['used', 'withdrawn'] && state.status == event.kind && state.balance == 0)
          || (event.kind == 'reversal' && state.status == 'active' && state.balance == previous.balance + reversalAmount(event, id)));
    }

    function correctingOpening(id, previous, state) {
      let event = getAfter(eventPath(state.lastEvent)).data;
      let prior = get(eventPath(previous.lastEvent)).data;
      let source = prior.kind == 'opening_correction' ? prior.details.sourceKind : prior.kind;
      let lot = getAfter(chemicalPath(id)).data;
      return event.kind == 'opening_correction' && event.changes.keys().size() == 1
        && event.details.keys().hasOnly(['intent', 'previousId', 'sourceKind'])
        && event.details.previousId == previous.lastEvent && event.details.sourceKind == source
        && source in ['opening', 'receipt'] && previous.status == 'active' && state.status == 'active'
        && state.unit == previous.unit && previous.balance == previous.initial && state.balance == state.initial
        && event.changes[id].before == previous.balance && state.initial != previous.initial
        && (source == 'opening' || (state.initial > 0 && state.initial <= lot.packageAmount
          && sameDimension(state.unit, lot.packageUnit)));
    }

    function eventTarget(keys, index, id) {
      return keys.size() <= index || getAfter(stockPath(keys[index])).data.lastEvent == id;
    }

    function reversalEvent(data, id) {
      let prior = get(eventPath(data.details.originalId)).data;
      return id == 'reverse_' + data.details.originalId
        && prior.kind in ['withdrawal', 'preparation']
        && prior.changes.keys().toSet() == data.changes.keys().toSet();
    }

    function validEventChanges(data, id) {
      let keys = data.changes.keys();
      return (keys.size() == 0 && data.kind in ['preparation', 'reversal'] && data.anchor == '')
        || (keys.size() > 0 && keys.size() <= 8 && data.anchor in keys
          && eventTarget(keys, 0, id) && eventTarget(keys, 1, id) && eventTarget(keys, 2, id) && eventTarget(keys, 3, id)
          && eventTarget(keys, 4, id) && eventTarget(keys, 5, id) && eventTarget(keys, 6, id) && eventTarget(keys, 7, id));
    }

    function validPreparation(details) {
      return details.keys().hasOnly(['intent', 'recipeId', 'recipeVersion', 'recipeName', 'methodId', 'methodName',
          'volume', 'baseVolume', 'ingredients', 'instruction'])
        && details.recipeId is string && details.methodId is string
        && details.recipeName is string && details.methodName is string
        && details.recipeVersion is int && details.recipeVersion >= 1
        && details.volume in [50, 100, 250, 500, 1000] && details.baseVolume is int && details.baseVolume > 0
        && details.ingredients is list && details.ingredients.size() > 0
        && details.instruction is string && details.instruction.size() <= 4000;
    }

    function validTask(data) {
      return data.keys().hasAll(['name', 'lab', 'doneDate', 'timestamp'])
        && data.keys().hasOnly(['name', 'lab', 'category', 'doneDate', 'timestamp', 'lastDoneYear'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.lab in ['woda', 'scieki']
        && (!('category' in data) || data.category in ['Archiwalna', 'Slepa', 'Probkobranie', 'Porownania'])
        && (data.doneDate == null || validDate(data.doneDate))
        && data.timestamp is int
        && (!('lastDoneYear' in data) || data.lastDoneYear == null || data.lastDoneYear is int);
    }

    function waterPlanKey(key) {
      return key.matches('^('
        + 'barwa-(slepa|por|gor|spo|pod)'
        + '|chlor-(slepa|por|spo)'
        + '|chlorki-(arch|slepa|por|dol|gor|spo|pod|pow)'
        + '|glin-(arch|slepa|por|dol|gor)'
        + '|indeks-(arch|slepa|por|dol|gor|spo|pod|pow)'
        + '|magnez-(slepa|por|dol)'
        + '|mangan-(arch|slepa|por|gor|spo|pod)'
        + '|amon-(arch|slepa|por|spo|stud)'
        + '|azotyny-(arch|slepa|por|dol|gor|spo|stud|pow|sc)'
        + '|azotany-(slepa|por|gor|spo|stud|pow|sc)'
        + '|ph-(slepa|por|spo|stud|pow|sc)'
        + '|przewod-(slepa|por|spo|stud|pow)'
        + '|siar-g-(arch|slepa|por|dol|gor|pod|pow)'
        + '|siar-t-(arch|slepa|por|gor|spo)'
        + '|twardosc-(slepa|por|dol|gor|spo|pod)'
        + '|wapn-(slepa|por|dol|gor|spo)'
        + '|zelazo-(arch|slepa|por|gor|spo|pod|przem)'
        + ')$');
    }

    function annualWaterPath(id) {
      return id.matches('^woda_roczna_.*$');
    }

    function waterSource(id, name, category) {
      let task = get(/databases/$(database)/documents/harmonogram/$(id)).data;
      return id.matches('^[A-Za-z0-9_-]{1,128}$') && !annualWaterPath(id) && task.lab == 'woda'
        && task.get('category', 'Archiwalna') in ['Archiwalna', 'Slepa', 'Probkobranie', 'Porownania']
        && (name == null || (task.name == name && task.get('category', 'Archiwalna') == category));
    }

    function waterDatePattern(year) {
      let number = int(year);
      let leap = number % 4 == 0 && (number % 100 != 0 || number % 400 == 0);
      return year + '-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]'
        + (leap ? '|29' : '') + '))';
    }

    function validWaterDate(date, year) {
      return date is string && date.matches('^' + waterDatePattern(year) + '$');
    }

    function waterMeasurementList(joined, count, width, pattern) {
      // Check that each map element contributes exactly one part to the joined value.
      return joined.size() == (width + 1) * count - 1
        && joined.matches('^' + pattern + '(_' + pattern + '){0,5}$');
    }

    function validWaterMeasurements(data) {
      let entries = data.measurements;
      let date = waterDatePattern(data.year);
      let id = '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}';
      return entries is map && entries.size() <= 6
        && (entries.size() == 0 || (data.origin == 'plan' && data.itemKey in ['siar-g-dol', 'siar-g-gor']
          && waterMeasurementList(entries.keys().join('_'), entries.size(), 36, id)
          && waterMeasurementList(entries.values().join('_'), entries.size(), 10, date)));
    }

    function validAnnualWater(id, data) {
      let fields = ['lab', 'category', 'year', 'origin', 'itemKey', 'planVersion', 'timestamp',
        'doneDate', 'note', 'legacyTaskId', 'measurements', 'revision', 'taskName', 'taskCategory'];
      return data.keys().hasOnly(fields) && data.lab == 'woda'
        && data.category == 'WodaRoczna' && data.year is string && data.year.matches('^[0-9]{4}$')
        && int(data.year) >= 2026 && data.origin in ['plan', 'manual'] && data.itemKey is string
        && id == 'woda_roczna_' + data.year + '_' + data.origin + '_' + data.itemKey
        && data.timestamp is int && data.revision is int && data.revision >= 1 && data.note is string && data.note.size() <= 300
        && (data.doneDate == null || validWaterDate(data.doneDate, data.year))
        && data.legacyTaskId is string
        && ((data.origin == 'plan'
            && ((data.planVersion == 'woda-2026.1' && waterPlanKey(data.itemKey))
              || (data.planVersion == 'woda-2026.2' && data.itemKey == 'przewod-sc'))
            && !data.keys().hasAny(['taskName', 'taskCategory']))
          || (data.origin == 'manual' && data.planVersion == '' && data.legacyTaskId == ''
            && data.taskName is string && data.taskName.size() > 0 && data.taskName.size() <= 200
            && data.taskCategory in ['Archiwalna', 'Slepa', 'Probkobranie', 'Porownania']))
        && validWaterMeasurements(data);
    }

    function validInitialWaterSource(data) {
      return data.origin == 'manual' ? waterSource(data.itemKey, data.taskName, data.taskCategory)
        : (data.legacyTaskId == '' || waterSource(data.legacyTaskId, null, null));
    }

    function validEquipment(data) {
      return data.keys().hasAll(['name', 'month', 'doneDate', 'timestamp'])
        && data.keys().hasOnly(['name', 'month', 'type', 'doneDate', 'timestamp'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.month is string && data.month.matches('^(0[1-9]|1[0-2])$')
        && (!('type' in data) || data.type in ['Wzorcowanie', 'Sprawdzenie', 'Kalibracja'])
        && (data.doneDate == null || validDate(data.doneDate))
        && data.timestamp is int;
    }

    function validEvent(data) {
      return data.keys().hasAll(['title', 'date', 'timestamp'])
        && data.keys().hasOnly(['title', 'date', 'timestamp'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && validDate(data.date) && data.date != ''
        && data.timestamp is int;
    }

    match /app_users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /odczynniki/{documentId} {
      allow read: if activeUser();
      allow create: if activeUser() && validChemical(request.resource.data)
        && (request.resource.data.get('productId', documentId) == documentId
          || (!request.resource.data.keys().hasAny(['orderDescription', 'orderPackaging'])
            && isProductRoot(request.resource.data.productId, request.resource.data)));
      allow update: if activeUser() && validChemical(request.resource.data)
        && (request.resource.data.get('productId', documentId) == documentId
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderDescription', 'orderPackaging']))
        && (resource.data.get('productId', documentId) == request.resource.data.get('productId', documentId)
          || (!('productId' in resource.data) && !exists(stockPath(documentId))
            && isProductRoot(request.resource.data.productId, request.resource.data)));
    }

    match /magazyn_partie/{documentId} {
      allow read: if activeUser();
      allow create: if activeUser() && validStock(request.resource.data)
        && linkedStock(documentId, request.resource.data) && startingStock(documentId, request.resource.data);
      allow update: if activeUser() && validStock(request.resource.data) && linkedStock(documentId, request.resource.data)
        && (changingStock(documentId, resource.data, request.resource.data)
          || correctingOpening(documentId, resource.data, request.resource.data));
    }

    match /magazyn_operacje/{documentId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['kind', 'anchor', 'changes', 'details', 'createdAt'])
        && request.resource.data.kind in ['receipt', 'opening', 'opening_correction', 'withdrawal', 'preparation', 'used', 'withdrawn', 'reversal']
        && request.resource.data.createdAt == request.time && request.resource.data.details is map
        && request.resource.data.details.intent is string && request.resource.data.details.intent.matches('^[a-f0-9]{64}$')
        && validEventChanges(request.resource.data, documentId)
        && (!('delivery' in request.resource.data.details)
          || (request.resource.data.kind == 'receipt' && linkedOrderReceipt(request.resource.data.details.delivery, documentId)))
        && (request.resource.data.kind != 'preparation' || validPreparation(request.resource.data.details))
        && (request.resource.data.kind != 'reversal' || reversalEvent(request.resource.data, documentId));
    }

    function named(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    match /magazyn_metody/{documentId} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && request.resource.data.keys().hasOnly(['name', 'usage'])
        && named(request.resource.data) && request.resource.data.usage is list;
    }

    function validRecipe(data) {
      return data.keys().hasOnly(['name', 'baseVolume', 'defaultVolume', 'scalable', 'methods', 'ingredients', 'instruction', 'version'])
        && named(data) && data.baseVolume is int && data.baseVolume > 0 && data.baseVolume <= 1000000
        && data.defaultVolume in [50, 100, 250, 500, 1000] && data.scalable is bool
        && (data.scalable || data.defaultVolume == data.baseVolume)
        && data.methods is list && data.methods.size() > 0 && data.ingredients is list && data.ingredients.size() > 0
        && data.instruction is string && data.instruction.size() <= 4000 && data.version is int && data.version > 0;
    }

    match /magazyn_receptury/{documentId} {
      allow read: if activeUser();
      allow create: if activeUser() && validRecipe(request.resource.data) && request.resource.data.version == 1;
      allow update: if activeUser() && validRecipe(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;
    }

    match /magazyn_obliczenia/{documentId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['methodId', 'methodName', 'date', 'count', 'counts', 'solutions', 'commercial', 'createdAt'])
        && request.resource.data.methodId is string && request.resource.data.methodName is string
        && validDate(request.resource.data.date) && request.resource.data.date != ''
        && request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.count <= 1000000
        && request.resource.data.counts is list && request.resource.data.counts.size() == 5
        && request.resource.data.solutions is list && request.resource.data.commercial is list
        && request.resource.data.createdAt == request.time;
    }

    match /magazyn_zamowienia/{documentId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly(['lines', 'date', 'status', 'createdAt', 'requester'])
        && (!('requester' in request.resource.data)
          || request.resource.data.requester in ['B. Joachim', 'A. Cieniewski', 'K. Łoboda', 'J. Gosławska', 'M. Piasecka'])
        && request.resource.data.lines is list && request.resource.data.lines.size() > 0
        && validDate(request.resource.data.date) && request.resource.data.date != ''
        && request.resource.data.status == 'generated' && request.resource.data.createdAt == request.time;
      allow update: if activeUser()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderedAt'])
          && resource.data.status == 'generated' && request.resource.data.status == 'ordered'
          && request.resource.data.orderedAt == request.time)
          || updatesReceivedOrder(documentId, resource.data, request.resource.data));
    }

    match /harmonogram/{documentId} {
      allow read: if activeUser();
      allow delete: if activeUser() && !annualWaterPath(documentId)
        && resource.data.get('category', '') != 'WodaRoczna';
      allow create: if activeUser() && (annualWaterPath(documentId)
        ? validAnnualWater(documentId, request.resource.data) && request.resource.data.revision == 1
          && validInitialWaterSource(request.resource.data) : validTask(request.resource.data));
      allow update: if activeUser() && (annualWaterPath(documentId)
        ? resource.data.category == 'WodaRoczna'
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.timestamp == resource.data.timestamp
          && request.resource.data.planVersion == resource.data.planVersion
          && request.resource.data.get('taskName', '') == resource.data.get('taskName', '')
          && request.resource.data.get('taskCategory', '') == resource.data.get('taskCategory', '')
          && validAnnualWater(documentId, request.resource.data)
          && (request.resource.data.legacyTaskId == resource.data.legacyTaskId
            || (resource.data.legacyTaskId == '' && waterSource(request.resource.data.legacyTaskId, null, null)))
        : resource.data.get('category', '') != 'WodaRoczna' && validTask(request.resource.data));
    }

    function equipmentMode() {
      let path = /databases/$(database)/documents/equipmentState/cutover;
      return exists(path) ? get(path).data.mode : 'legacy';
    }
    function equipmentWrite() {
      return activeUser() && equipmentMode() == 'active';
    }
    function equipmentId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }
    function equipmentToken(id) {
      return id is string && id.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$');
    }
    function equipmentYear(year) {
      return year is string && year.matches('^20[0-9]{2}$|^21[0-9]{2}$');
    }
    function equipmentText(value, max) {
      return value is string && value.size() <= max;
    }
    function equipmentRevision(data) {
      return data.revision is int && data.revision > 0;
    }
    function equipmentDevice(data) {
      return data.keys().hasAll(['name','number','notes','status','verified','mergedInto','nextActivity','revision'])
        && data.keys().hasOnly(['name','number','notes','status','verified','mergedInto','nextActivity','revision'])
        && equipmentText(data.name, 200) && data.name.matches('.*[^\\s].*')
        && equipmentText(data.number, 80) && equipmentText(data.notes, 500)
        && data.verified is bool && data.status in ['active','withdrawn']
        && (data.mergedInto == '' || (data.status == 'withdrawn' && equipmentId(data.mergedInto)))
        && data.nextActivity is int && data.nextActivity >= 1 && data.nextActivity <= 101 && equipmentRevision(data);
    }
    function equipmentActivityId(value) {
      return value is string && value.matches('^a([1-9][0-9]?|100)$');
    }
    function equipmentActivity(key, data) {
      return data.keys().hasAll(['device','activity','kind','label','active','revision'])
        && data.keys().hasOnly(['device','activity','kind','label','active','revision'])
        && equipmentId(data.device) && equipmentActivityId(data.activity) && key == data.device + ':' + data.activity
        && equipmentText(data.kind, 80) && data.kind.matches('.*[^\\s].*') && equipmentText(data.label, 150)
        && data.active is bool && equipmentRevision(data)
        && getAfter(/databases/$(database)/documents/equipmentDevices/$(data.device)).data.nextActivity > int(data.activity.split('a')[1]);
    }

    function eqYearPath(year) {
      return /databases/$(database)/documents/equipmentYears/$(year);
    }
    function eqVersionPath(year, version) {
      return /databases/$(database)/documents/equipmentYears/$(year)/versions/$(version);
    }
    function eqRowPath(year, version, row) {
      return /databases/$(database)/documents/equipmentYears/$(year)/versions/$(version)/rows/$(row);
    }
    function eqResultPath(year, key) {
      return /databases/$(database)/documents/equipmentYears/$(year)/results/$(key);
    }
    function eqHistoryPath(event) {
      return /databases/$(database)/documents/equipmentHistory/$(event);
    }
    function eqPrevious(year) {
      let path = eqYearPath(year);
      return exists(path) ? get(path).data : {'revision': 0, 'published': '', 'draft': ''};
    }
    function eqHeader(data) {
      return data.keys().hasAll(['revision','published','draft','last','slot','action'])
        && data.keys().hasOnly(['revision','published','draft','last','slot','action'])
        && equipmentRevision(data)
        && (data.published == '' || equipmentToken(data.published))
        && (data.draft == '' || equipmentToken(data.draft))
        && equipmentToken(data.last);
    }
    function eqSourceCurrent(v) {
      let src = get(eqYearPath(v.sourceYear)).data;
      return src.revision == v.sourceRevision && src.published == v.sourceVersion;
    }
    function eqPlanTransition(year, data, before) {
      let v = getAfter(eqVersionPath(year, data.last)).data;
      return data.slot == '' && v.state == 'sealed' && v.author == request.auth.uid && v.base == before.revision
        && v.mode == data.action && !('sealedAt' in get(eqVersionPath(year, data.last)).data)
        && (data.action == 'approve'
          ? data.published == data.last && data.draft == ''
          : data.published == before.published && data.draft == data.last)
        && (data.action != 'copy' || (before.revision == 0 && eqSourceCurrent(v)));
    }
    function eqResultTransition(year, data, before) {
      let event = getAfter(eqHistoryPath(data.last)).data;
      return before.published != '' && data.published == before.published && data.draft == before.draft
        && event.year == year && data.slot == event.key
        && !exists(eqHistoryPath(data.last)) && event.at == request.time;
    }
    function eqVersionState(year, v) {
      return v.keys().hasAll(['author','base','mode','sourceYear','sourceVersion','sourceRevision','state','createdAt'])
        && v.keys().hasOnly(['author','base','mode','sourceYear','sourceVersion','sourceRevision','state','createdAt'])
        && v.author == request.auth.uid && v.base == eqPrevious(year).revision && v.state == 'open' && v.createdAt == request.time
        && (v.mode == 'copy'
          ? v.base == 0 && equipmentYear(v.sourceYear) && v.sourceYear != year
            && equipmentToken(v.sourceVersion) && v.sourceRevision is int && eqSourceCurrent(v)
          : v.mode in ['draft','approve'] && v.sourceYear == '' && v.sourceVersion == '' && v.sourceRevision == 0);
    }
    function eqSeal(year, version) {
      let v = resource.data;
      let header = getAfter(eqYearPath(year)).data;
      return v.state == 'open' && v.author == request.auth.uid
        && request.resource.data.diff(v).affectedKeys().hasOnly(['state','sealedAt'])
        && request.resource.data.state == 'sealed' && request.resource.data.sealedAt == request.time
        && header.last == version && header.action == v.mode && header.revision == v.base + 1;
    }
    function eqSlot(slots, key) {
      return !(key in slots) || equipmentToken(slots[key]);
    }
    function eqSlots(s) {
      return s is map && s.size() > 0 && s.values().toSet().size() == s.size()
        && s.keys().hasOnly(['01','02','03','04','05','06','07','08','09','10','11','12'])
        && eqSlot(s,'01') && eqSlot(s,'02') && eqSlot(s,'03') && eqSlot(s,'04')
        && eqSlot(s,'05') && eqSlot(s,'06') && eqSlot(s,'07') && eqSlot(s,'08')
        && eqSlot(s,'09') && eqSlot(s,'10') && eqSlot(s,'11') && eqSlot(s,'12');
    }
    function eqInherited(year, version, row, ids) {
      return version != '' && exists(eqRowPath(year, version, row))
        && ids.hasOnly(get(eqRowPath(year, version, row)).data.slots.values());
    }
    function eqValidRow(year, version, row, data) {
      let v = get(eqVersionPath(year, version)).data;
      let dev = get(/databases/$(database)/documents/equipmentDevices/$(data.device)).data;
      let act = get(/databases/$(database)/documents/equipmentActivities/$(row)).data;
      let previous = eqPrevious(year);
      return data.keys().hasAll(['device','activity','slots']) && data.keys().hasOnly(['device','activity','slots'])
        && equipmentId(data.device) && equipmentActivityId(data.activity) && row == data.device + ':' + data.activity
        && act.device == data.device && act.activity == data.activity && eqSlots(data.slots)
        && v.state == 'open' && v.author == request.auth.uid && previous.revision == v.base
        && getAfter(eqVersionPath(year, version)).data.state == 'open'
        && (v.mode == 'copy'
          ? dev.status == 'active' && act.active == true
            && data.slots.keys().hasOnly(get(eqRowPath(v.sourceYear, v.sourceVersion, row)).data.slots.keys())
            && !data.slots.values().hasAny(get(eqRowPath(v.sourceYear, v.sourceVersion, row)).data.slots.values())
          : (dev.status == 'active' && act.active == true)
            || eqInherited(year, previous.published, row, data.slots.values())
            || eqInherited(year, previous.draft, row, data.slots.values()));
    }
    function eqExecutionDate(data) {
      return equipmentText(data.notes, 500)
        && (data.date == '' ? data.notes == '' : (validDate(data.date)
          && eqRealDate(data.date.split('-'))));
    }
    function eqRealDate(parts) {
      let y = int(parts[0]);
      let m = int(parts[1]);
      let d = int(parts[2]);
      return (m != 2 || d < 29 || (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)))
        && timestamp.date(y, m, d) <= request.time + duration.value(2, 'h');
    }
    function eqResult(year, key, data, before) {
      let row = data.device + ':' + data.activity;
      let header = get(eqYearPath(year)).data;
      let next = getAfter(eqYearPath(year)).data;
      let event = getAfter(eqHistoryPath(data.event)).data;
      return data.keys().hasAll(['device','activity','term','month','date','notes','revision','event'])
        && data.keys().hasOnly(['device','activity','term','month','date','notes','revision','event'])
        && equipmentId(data.device) && equipmentActivityId(data.activity) && equipmentToken(data.term)
        && key == row + ':' + data.term && data.month.matches('^(0[1-9]|1[0-2])$')
        && eqExecutionDate(data) && equipmentToken(data.event)
        && (before.date == '' || data.month == before.get('month', data.month))
        && (before.date != '' || data.date != '') && data.revision == before.revision + 1
        && (before.date != '' || get(eqRowPath(year, header.published, row)).data.slots[data.month] == data.term)
        && next.action == 'execute' && next.revision == header.revision + 1 && next.last == data.event
        && !exists(eqHistoryPath(data.event)) && event.key == key && event.year == year
        && event.at == request.time && event.beforeDate == before.date && event.beforeNotes == before.notes
        && (data.date == '' ? event.action == 'undo' : (before.date == '' ? event.action == 'complete' : event.action == 'correct'));
    }
    function eqHistory(id, data) {
      let result = getAfter(eqResultPath(data.year, data.key)).data;
      let dev = get(/databases/$(database)/documents/equipmentDevices/$(data.device)).data;
      let act = get(/databases/$(database)/documents/equipmentActivities/$(data.device + ':' + data.activity)).data;
      return data.keys().hasOnly(['year','key','device','activity','term','month','action','beforeDate','beforeNotes','date','notes',
          'revision','at','name','number','kind','label'])
        && equipmentYear(data.year) && data.action in ['complete','correct','undo']
        && data.at == request.time && result.event == id && result.revision == data.revision
        && data.device == result.device && data.activity == result.activity && data.term == result.term && data.month == result.month
        && data.date == result.date && data.notes == result.notes
        && data.name == dev.name && data.number == dev.number && data.kind == act.kind && data.label == act.label
        && (!exists(eqResultPath(data.year, data.key))
          ? data.revision == 1
          : get(eqResultPath(data.year, data.key)).data.revision == data.revision - 1);
    }
    function eqLegacyLink(id, data) {
      return data.keys().hasOnly(['device','activity','revision'])
        && equipmentId(data.device) && equipmentActivityId(data.activity) && equipmentRevision(data)
        && exists(/databases/$(database)/documents/wzorcowanie/$(id))
        && getAfter(/databases/$(database)/documents/equipmentActivities/$(data.device + ':' + data.activity)).data.device == data.device;
    }

    match /equipmentState/cutover {
      allow get: if activeUser();
    }
    match /equipmentDevices/{id} {
      allow read: if activeUser();
      allow create: if equipmentWrite() && equipmentId(id) && equipmentDevice(request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.mergedInto == '';
      allow update: if equipmentWrite() && equipmentDevice(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.nextActivity >= resource.data.nextActivity
        && (request.resource.data.mergedInto == resource.data.mergedInto || request.resource.data.mergedInto == ''
          || (request.resource.data.mergedInto != id
            && getAfter(/databases/$(database)/documents/equipmentDevices/$(request.resource.data.mergedInto)).data.status == 'active'));
    }
    match /equipmentActivities/{id} {
      allow read: if activeUser();
      allow create: if equipmentWrite() && equipmentActivity(id, request.resource.data) && request.resource.data.revision == 1;
      allow update: if equipmentWrite() && equipmentActivity(id, request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
    }
    match /equipmentLinks/{id} {
      allow read: if activeUser();
      allow create: if equipmentWrite() && eqLegacyLink(id, request.resource.data) && request.resource.data.revision == 1;
      allow update: if equipmentWrite() && eqLegacyLink(id, request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
    }
    match /equipmentYears/{year} {
      allow read: if activeUser();
      allow create, update: if equipmentWrite() && equipmentYear(year)
        && eqHeader(request.resource.data) && request.resource.data.revision == eqPrevious(year).revision + 1
        && (request.resource.data.action == 'execute'
          ? eqResultTransition(year, request.resource.data, eqPrevious(year))
          : request.resource.data.action in ['approve','draft','copy']
            && eqPlanTransition(year, request.resource.data, eqPrevious(year)));
      match /versions/{version} {
        allow read: if activeUser();
        allow create: if equipmentWrite() && equipmentYear(year) && equipmentToken(version)
          && eqVersionState(year, request.resource.data);
        allow update: if equipmentWrite() && eqSeal(year, version);
        match /rows/{row} {
          allow read: if activeUser();
          allow create: if equipmentWrite() && eqValidRow(year, version, row, request.resource.data);
        }
      }
      match /results/{key} {
        allow read: if activeUser();
        allow create: if equipmentWrite() && eqResult(year, key, request.resource.data, {'revision': 0, 'date': '', 'notes': ''});
        allow update: if equipmentWrite() && eqResult(year, key, request.resource.data, resource.data);
      }
    }
    match /equipmentHistory/{id} {
      allow read: if activeUser();
      allow create: if equipmentWrite() && eqHistory(id, request.resource.data);
    }

    match /wzorcowanie/{documentId} {
      allow read: if activeUser();
      allow delete: if activeUser() && equipmentMode() == 'legacy';
      allow create, update: if activeUser() && equipmentMode() == 'legacy' && validEquipment(request.resource.data);
    }

    match /wydarzenia/{documentId} {
      allow read, delete: if activeUser();
      allow create, update: if activeUser() && validEvent(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
